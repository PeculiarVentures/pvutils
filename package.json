    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PeculiarVentures/pvutils.git"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "main": "./build/utils.js",
  "module": "./build/utils.es.js",
  "types": "./build/index.d.ts",
  "scripts": {
