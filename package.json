    "format:check": "oxfmt --check",
    "build": "rollup -c",
    "coverage": "vitest run --coverage",
    "release": "standard-version"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "rollup": "2.79.2",
    "rollup-plugin-dts": "^4.1.0",
    "rollup-plugin-typescript2": "^0.31.2",
    "standard-version": "^9.5.0",
    "typescript": "^4.5.5",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=10",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=16.0.0"
  }
